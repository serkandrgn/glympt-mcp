{
  "name": "@glympt/mcp",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Glympt MCP adapter for domain technology enrichment, filtered prospecting, saved lists and CSV exports.",
  "homepage": "https://glympt.com/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serkandrgn/glympt-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/serkandrgn/glympt-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "glympt",
    "technographics",
    "enrichment",
    "prospecting"
  ],
  "mcpName": "io.github.serkandrgn/glympt",
  "bin": {
    "glympt-mcp": "dist/stdio.js"
  },
  "files": [
    "LICENSE",
    "dist/stdio.js",
    "dist/server.js",
    "dist/api-client.js",
    "dist/config.js",
    "docs/client-setup.md",
    "server.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "dev:hosted": "tsx src/hosted.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run lint && npm test",
    "test:package": "node scripts/verify-package.mjs",
    "check": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "start:hosted": "node dist/hosted.js",
    "health": "node dist/health.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "24.10.2",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
