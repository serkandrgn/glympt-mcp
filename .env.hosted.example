# Public HTTPS origins; replace staging placeholders with your deployment.
GLYMPT_API_BASE_URL=https://api-staging.example.com
GLYMPT_MCP_RESOURCE_URL=https://mcp-staging.example.com/mcp
# Share only with the backend's MCP_GATEWAY_SECRET. Generate: openssl rand -hex 32
GLYMPT_MCP_GATEWAY_SECRET=replace_with_a_random_secret_of_at_least_32_characters
GLYMPT_MCP_PORT=3100
# Optional, exact comma-separated browser origins. Cloud clients normally send no Origin.
GLYMPT_MCP_ALLOWED_ORIGINS=
